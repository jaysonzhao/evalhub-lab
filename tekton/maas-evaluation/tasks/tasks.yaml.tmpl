      image: __RUNNER_IMAGE__
      imagePullPolicy: IfNotPresent
      command: [python3, /opt/maas-evaluation/runner/cli.py]
      args:
        - collect
        - --links-result
        - $(results.mlflow-links.path)
        - --bundle-digest-result
        - $(results.bundle-digest.path)
      env:
        - name: RESULTS_DIR
          value: $(workspaces.results.path)
        - name: RUNTIME_CONFIG
          value: /etc/maas-evaluation/runtime.json
        - name: DATA_PROFILE_PATH
          value: /etc/maas-evaluation/dataset-profile.json
        - name: PIPELINE_NAMESPACE
