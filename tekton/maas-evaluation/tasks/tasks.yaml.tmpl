apiVersion: tekton.dev/v1
kind: Task
metadata:
  name: maas-eval-preflight
  labels:
    app.kubernetes.io/name: maas-evaluation
spec:
  params:
    - name: pipeline-run-uid
      type: string
    - name: pipeline-run-name
      type: string
    - name: maas-endpoint
      type: string
    - name: model-secret-name
      type: string
    - name: model-name
      type: string
    - name: profile
      type: string
    - name: datasets
      type: array
  workspaces:
    - name: results
  results:
    - name: profile-hash
      description: Hash of the frozen model, profile, dataset selection, and data manifest.
  volumes:
    - name: runner-config
      configMap:
        name: maas-evaluation-runtime
  steps:
    - name: preflight
      image: __RUNNER_IMAGE__
      imagePullPolicy: IfNotPresent
      command: [python3, /opt/maas-evaluation/runner/cli.py]
      args:
        - preflight
        - --endpoint
        - $(params.maas-endpoint)
        - --model-secret-name
        - $(params.model-secret-name)
        - --model-name
        - $(params.model-name)
        - --profile
        - $(params.profile)
        - --dataset
        - $(params.datasets[*])
        - --result-path
        - $(results.profile-hash.path)
      env:
        - name: RESULTS_DIR
          value: $(workspaces.results.path)
        - name: RUNTIME_CONFIG
          value: /etc/maas-evaluation/runtime.json
        - name: DATA_PROFILE_PATH
          value: /etc/maas-evaluation/dataset-profile.json
        - name: PIPELINE_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: LEDGER_REQUIRED
          value: "true"
        - name: PIPELINE_RUN_UID
          value: $(params.pipeline-run-uid)
        - name: PIPELINE_RUN_NAME
          value: $(params.pipeline-run-name)
      volumeMounts:
        - name: runner-config
          mountPath: /etc/maas-evaluation
          readOnly: true
---
apiVersion: tekton.dev/v1
kind: Task
metadata:
  name: maas-eval-submit
  labels:
    app.kubernetes.io/name: maas-evaluation
spec:
  params:
    - name: pipeline-run-uid
      type: string
    - name: pipeline-run-name
      type: string
    - name: datasets
      type: array
  workspaces:
    - name: results
  results:
    - name: job-ids
      description: Selected benchmark IDs and accepted EvalHub job IDs; secrets are excluded.
  volumes:
    - name: runner-config
      configMap:
        name: maas-evaluation-runtime
  steps:
    - name: submit
      image: __RUNNER_IMAGE__
      imagePullPolicy: IfNotPresent
      command: [python3, /opt/maas-evaluation/runner/cli.py]
      args:
        - submit
        - --dataset
        - "$(params.datasets[*])"
        - --job-ids-result
        - $(results.job-ids.path)
      env:
        - name: RESULTS_DIR
          value: $(workspaces.results.path)
        - name: RUNTIME_CONFIG
          value: /etc/maas-evaluation/runtime.json
        - name: DATA_PROFILE_PATH
          value: /etc/maas-evaluation/dataset-profile.json
        - name: PIPELINE_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: LEDGER_REQUIRED
          value: "true"
        - name: PIPELINE_RUN_UID
          value: $(params.pipeline-run-uid)
        - name: PIPELINE_RUN_NAME
          value: $(params.pipeline-run-name)
      volumeMounts:
        - name: runner-config
          mountPath: /etc/maas-evaluation
          readOnly: true
---
