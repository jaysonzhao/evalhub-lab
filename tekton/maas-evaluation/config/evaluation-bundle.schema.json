{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evalhub-lab.invalid/schemas/model-evaluation-dashboard-bundle.v1.json",
  "title": "MaaS evaluation dashboard bundle",
  "type": "object",
  "required": ["schema_version", "generated_at", "profile", "profile_hash", "selected_datasets", "datasets", "not_selected", "question_rows", "source_manifests", "evaluations", "summary_only", "source"],
  "properties": {
    "schema_version": {"const": "model-evaluation-dashboard-bundle.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "profile": {"enum": ["smoke", "coverage", "full"]},
    "profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_datasets": {"allOf": [{"$ref": "#/$defs/datasetArray"}, {"minItems": 1}]},
    "datasets": {"type": "array", "items": {"$ref": "#/$defs/datasetResult"}},
    "not_selected": {"$ref": "#/$defs/datasetArray", "minItems": 0},
    "question_rows": {
      "type": "object",
      "required": ["status", "rows"],
      "properties": {"status": {"const": "unavailable_in_pipeline_bundle"}, "rows": {"type": "array", "maxItems": 0}},
      "additionalProperties": false
    },
    "source_manifests": {"type": "object"},
    "evaluations": {"type": "array", "items": {"$ref": "#/$defs/dashboardEvaluation"}},
    "summary_only": {"const": true},
    "source": {"const": "EvalHub and MLflow"}
  },
  "$defs": {
    "dataset": {"enum": ["hkmmlu", "tmmluplus", "cmmlu", "qualbench"]},
    "datasetArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/dataset"}},
    "metricMap": {"type": "object", "additionalProperties": {"type": ["number", "integer", "string", "boolean", "null"]}},
    "metricRow": {
      "type": "object",
      "required": ["key", "raw_value", "value", "unit", "status", "mapped"],
      "properties": {
        "key": {"type": "string"},
        "raw_value": {"type": ["number", "integer", "string", "boolean", "null"]},
        "value": {"type": ["number", "integer", "null"]},
        "unit": {"enum": ["%", "questions", "raw"]},
        "status": {"enum": ["available", "invalid"]},
        "mapped": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "datasetResult": {
      "type": "object",
      "required": ["dataset", "status", "evalhub_job_id", "mlflow_run_id", "mlflow_url", "metrics", "metrics_display", "expected_attempts", "provenance"],
      "properties": {
        "dataset": {"$ref": "#/$defs/dataset"},
        "status": {"enum": ["passed", "failed"]},
        "evalhub_job_id": {"type": ["string", "null"]},
        "mlflow_run_id": {"type": ["string", "null"]},
        "mlflow_url": {"type": ["string", "null"], "format": "uri"},
        "metrics": {"$ref": "#/$defs/metricMap"},
        "metrics_display": {"type": "array", "items": {"$ref": "#/$defs/metricRow"}},
        "expected_attempts": {"type": "integer", "minimum": 1},
        "provenance": {"type": "object"}
      },
      "additionalProperties": false
    },
    "dashboardEvaluation": {
      "type": "object",
      "required": ["schema_version", "source", "source_id", "workspace", "job_id", "run_id", "run_name", "state", "model", "benchmark", "provider_id", "protocol", "metrics_raw", "metrics", "score", "source_refs", "provenance", "completeness", "warnings"],
      "properties": {
        "schema_version": {"const": "evaluation-dashboard.v1"},
        "source": {"const": "evalhub"},
        "source_id": {"type": "string", "minLength": 1},
        "workspace": {"type": "string"},
        "job_id": {"type": ["string", "null"]},
        "run_id": {"type": ["string", "null"]},
        "run_name": {"type": ["string", "null"]},
        "state": {"type": "string"},
        "model": {"type": "object", "required": ["name", "url"], "properties": {"name": {"type": "string"}, "url": {"type": "string", "format": "uri"}}},
        "benchmark": {"$ref": "#/$defs/dataset"},
        "provider_id": {"type": "string"},
        "protocol": {"type": ["string", "null"]},
        "metrics_raw": {"$ref": "#/$defs/metricMap"},
        "metrics": {"type": "array", "items": {"$ref": "#/$defs/metricRow"}},
        "score": {"oneOf": [{"$ref": "#/$defs/metricRow"}, {"type": "null"}]},
        "source_refs": {"type": "object"},
        "provenance": {"type": "object"},
        "completeness": {"type": "object", "required": ["summary_metrics", "question_artifact"], "properties": {"summary_metrics": {"const": true}, "question_artifact": {"const": "not_exported_by_pipeline"}}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
