# ============================================================
# RHOAI EvalHub Lab — Environment Configuration
# ============================================================
# Workbench: Run 0_setup/2_eval_hub_setup.ipynb Step 0
#            — edit values in the cell and run. .env is auto-created.
#
# Local dev: cp sample.env .env && edit .env
# ============================================================

# --- Cluster Login (5_eval_guardrail admin setup) ---
CLUSTER_API=https://api.your-cluster.example.com:6443
CLUSTER_USER=kubeadmin
CLUSTER_PASS=                                 # Cluster login password

# --- Required: Your OpenShift AI Project ---
NAMESPACE=evalhub-lab                         # EvalHub lab namespace

# --- Required: Model Configuration ---
MODEL_NAME=publishers/llm/models/gpt-oss-20b  # RHOAI MaaS model ID
MODEL_ENDPOINT=https://maas.apps.cluster-v4vsc.v4vsc.sandbox287.opentlc.com/v1  # OpenAI-compatible MaaS base URL
MODEL_API_KEY=                                # Set a MaaS API key; the OpenShift login token is not an inference key

# --- Evaluation Settings ---
LIMIT=5                                       # Sample limit per benchmark (set higher for full eval)
BATCH_SIZE=8                                  # Batch size for evaluation

# --- EvalHub & MLflow ---
EVALHUB_URL=https://evalhub-evalhub-lab.apps.cluster-v4vsc.v4vsc.sandbox287.opentlc.com  # EvalHub Route
EVALHUB_AUTH_TOKEN=                            # OpenShift auth token (leave empty if oc login active)
MLFLOW_TRACKING_URI=https://mlflow.redhat-ods-applications.svc:8443  # MLflow tracking server URL

# --- Pipeline Server (4_eval_pipeline) ---
PIPELINE_API_URL=                             # KFP API URL: https://ds-pipeline-dspa.apps.<cluster-domain>
OCP_TOKEN=                                    # OpenShift token for KFP auth (falls back to EVALHUB_AUTH_TOKEN)

# --- S3 Object Storage (Pipeline artifacts & model storage) ---
AWS_S3_ENDPOINT=http://seaweedfs-s3.model-storage.svc:8333  # S3-compatible endpoint (MinIO, SeaweedFS, ODF, etc.)
AWS_ACCESS_KEY_ID=your-access-key             # S3 access key
AWS_SECRET_ACCESS_KEY=your-secret-key         # S3 secret key
AWS_S3_BUCKET=your-bucket                     # S3 bucket name for pipeline artifacts
AWS_DEFAULT_REGION=us-east-1                  # S3 region (default: us-east-1)
AWS_S3_FORCE_PATH_STYLE=true                  # Use path-style URLs (required for MinIO/SeaweedFS)

# --- Guardrails (5_eval_guardrail) ---
GUARDRAILS_ROUTE=                                    # NemoGuardrails route URL (set by 1_guardrail_setup.ipynb)
CONTENT_SAFETY_ENDPOINT=https://your-model-  # In-cluster content safety model endpoint
CONTENT_SAFETY_MODEL=llama-31-nemotron-safety-guard  # Served model name for the content safety model
CONTENT_SAFETY_API_KEY=your-api-key

# --- Notifications (optional) ---
SLACK_WEBHOOK_URL=                            # Slack Incoming Webhook URL for pipeline notifications

# ============================================================
# Example: MaaS endpoint with SeaweedFS
